# Apresento as variáveis necessárias para iniciar a API e conectar ao banco privado.
# Uso development enquanto login e permissões ainda não estão prontos.
NODE_ENV=development

# Escolho a porta do backend.
PORTA=3000

# Mantenho acesso local; para testar pelo celular na mesma rede, uso 0.0.0.0.
HOST=127.0.0.1

# Preencho meu .env com a URL privada do Neon. A conexão usa SSL.
DATABASE_URL=
