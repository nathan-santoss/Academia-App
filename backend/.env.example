# Apresento a configuração do backend sem incluir credenciais.
# Uso production no Render; as rotas de dados aguardam login e autorização reais.
NODE_ENV=development

# Priorizo PORT, fornecida automaticamente pelo Render.
PORT=3000

# Permito receber conexões pelo endereço de rede do servidor.
HOST=0.0.0.0

# Copio a URL privada do Neon somente para as variáveis de ambiente do backend.
DATABASE_URL=
