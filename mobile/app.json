{
  "expo": {
    "name": "Academia App",
    "slug": "academia-app",
    "platforms": [
      "android",
      "ios"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "academia-app",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.nathan.santosdev.academiaapp"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3440f106-1b3a-4d83-9724-7854d1e5e5f1"
      }
    },
    "owner": "nathan.santosdev"
  }
}
